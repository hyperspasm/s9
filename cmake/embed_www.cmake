# Embed every file under a directory as a C byte array, with a lookup table of
# URL path, MIME type, data, and size (the s9_www_file_t table in s9_www.h).
#
#   cmake -DSRC_DIR=<directory> -DOUT=<generated .c file> -P embed_www.cmake
#
# The output is rewritten only when its content changes, so an unchanged site
# does not trigger a rebuild.

if(NOT SRC_DIR OR NOT OUT)
    message(FATAL_ERROR "usage: cmake -DSRC_DIR=<dir> -DOUT=<file.c> -P embed_www.cmake")
endif()

function(mime_type ext out_var)
    string(TOLOWER "${ext}" ext)
    if(ext STREQUAL ".html")
        set(m "text/html")
    elseif(ext STREQUAL ".js")
        set(m "text/javascript")
    elseif(ext STREQUAL ".css")
        set(m "text/css")
    elseif(ext STREQUAL ".svg")
        set(m "image/svg+xml")
    elseif(ext STREQUAL ".png")
        set(m "image/png")
    elseif(ext STREQUAL ".ico")
        set(m "image/x-icon")
    elseif(ext STREQUAL ".json")
        set(m "application/json")
    elseif(ext STREQUAL ".txt")
        set(m "text/plain")
    elseif(ext STREQUAL ".woff2")
        set(m "font/woff2")
    elseif(ext STREQUAL ".wasm")
        set(m "application/wasm")
    else()
        set(m "application/octet-stream")
    endif()
    set(${out_var} "${m}" PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE files RELATIVE "${SRC_DIR}" "${SRC_DIR}/*")
list(SORT files)

set(out "// Generated by embed_www.cmake from ${SRC_DIR}. Do not edit.\n#include \"s9_www.h\"\n\n")
set(table "")
set(i 0)
foreach(rel ${files})
    file(READ "${SRC_DIR}/${rel}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR size "${hexlen} / 2")
    if(size EQUAL 0)
        set(bytes "0")
    else()
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n\t" bytes "${bytes}")
    endif()
    get_filename_component(ext "${rel}" LAST_EXT)
    mime_type("${ext}" mime)
    string(APPEND out "static const unsigned char file_${i}[] = {\n\t${bytes}\n};\n\n")
    string(APPEND table "\t{ \"/${rel}\", \"${mime}\", file_${i}, ${size} },\n")
    math(EXPR i "${i} + 1")
endforeach()

if(i EQUAL 0)
    set(table "\t{ 0, 0, 0, 0 },\n")
endif()
string(APPEND out "const s9_www_file_t s9_www_files[] = {\n${table}};\n\nconst unsigned int s9_www_file_count = ${i};\n")

file(WRITE "${OUT}.tmp" "${out}")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
file(REMOVE "${OUT}.tmp")
